{
  "name": "animus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d --wait && pnpm --filter @animus/brain run slaap-allen && pnpm --filter @animus/brain run backfill && pnpm --parallel --filter @animus/agent --filter @animus/face --filter @animus/dashboard run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "repl": "pnpm --filter @animus/brain run repl",
    "verwijder": "pnpm --filter @animus/brain run verwijder",
    "dashboard": "pnpm --filter @animus/dashboard dev",
    "db:migrate": "pnpm --filter @animus/db run db:migrate",
    "agent": "pnpm --filter @animus/agent start",
    "agent:download": "pnpm --filter @animus/agent download-files",
    "face": "pnpm --filter @animus/face dev"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "turbo": "2.11.3",
    "typescript": "5.9.3"
  }
}
