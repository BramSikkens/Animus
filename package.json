{
  "name": "animus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d --wait && pnpm --filter @animus/cli run slaap-allen && pnpm --parallel --filter @animus/agent --filter @animus/face --filter @animus/dashboard --filter @animus/worker run dev",
    "test": "turbo run test && node --test scripts/*.test.mjs",
    "kiosk": "node scripts/kiosk.mjs",
    "typecheck": "turbo run typecheck",
    "repl": "pnpm --filter @animus/cli run repl",
    "verwijder": "pnpm --filter @animus/cli run verwijder",
    "backfill": "pnpm --filter @animus/cli run backfill",
    "dashboard": "pnpm --filter @animus/dashboard dev",
    "db:migrate": "pnpm --filter @animus/db run db:migrate",
    "agent": "pnpm --filter @animus/agent start",
    "agent:download": "pnpm --filter @animus/agent download-files",
    "face": "pnpm --filter @animus/face dev",
    "worker": "pnpm --filter @animus/worker run dev"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "turbo": "2.11.3",
    "typescript": "5.9.3"
  }
}
