DATABASE_URL=postgres://animus:animus@localhost:5433/animus
# Tests maken hierop een wegwerp-database animus_test aan.
TEST_DATABASE_URL=postgres://animus:animus@localhost:5433/animus
TYPE2_LIGHT_MODEL=
TYPE2_HEAVY_MODEL=
# Type1 (Jev) via Vercel AI Gateway.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Spraak (LiveKit-agent + gezichtje-app). Mogen leeg blijven voor lokale dev: LIVEKIT_* vallen dan
# terug op de lokale docker-compose-server (devkey/secret), STT/TTS vallen zonder DEEPGRAM_API_KEY
# terug op OpenAI.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
# Reflectie bij stilte: na zoveel minuten zonder uiting reflecteert de wakkere Dynimo (hij blijft wakker).
# Fractioneel toegestaan; verkort dit alleen om te testen (bv. 0.1).
REFLECT_SILENCE_MINUTES=30

# Initiatief: basisinterval (minuten) van de check of de wakkere Dynimo zelf iets wil zeggen; de echte wachttijd
# schaalt met de N/P-kant van zijn Persoonlijkheid (x0.5 tot x2) plus spreiding. Fractioneel toegestaan.
INITIATIVE_CHECK_MINUTES=10
